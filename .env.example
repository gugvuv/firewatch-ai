# FireWatch AI - environment configuration (development defaults)
# Copy to .env and adjust. NEVER commit .env.

# --- Database ---
POSTGRES_DB=firewatch
POSTGRES_USER=firewatch
POSTGRES_PASSWORD=firewatch
DATABASE_URL=postgresql+psycopg://firewatch:firewatch@db:5432/firewatch

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Backend ---
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
# NASA FIRMS MAP_KEY (server-side only, never expose to browser)
FIRMS_MAP_KEY=

# --- Frontend (public) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
